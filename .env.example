# ==============================================================================
# CouturPro — Variables d'environnement requises
# P1-5 : Aucun fallback hardcodé dans le code. Ces variables DOIVENT être
# définies dans Lovable (Project Settings > Environment Variables) ou dans
# votre plateforme de déploiement (Cloudflare Pages, Netlify, etc.)
# ==============================================================================

# URL du projet Supabase (sans slash final)
# Exemple : https://xqlseyenwraopjfjsejh.supabase.co
VITE_SUPABASE_URL=

# Clé publishable Supabase (anon key — exposée au navigateur, sans danger)
# Commence par "sb_publishable_" (nouveau format) ou "eyJ..." (JWT legacy)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ==============================================================================
# Variables serveur uniquement (jamais exposées au navigateur)
# À configurer dans les secrets de l'Edge Function Supabase si utilisées.
# ==============================================================================

# Clé de service Supabase (service_role — JAMAIS dans VITE_*)
# SUPABASE_SERVICE_ROLE_KEY=

# Secret HMAC du webhook de paiement (futur Monniz)
# PAYMENT_WEBHOOK_SECRET=
